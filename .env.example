# Renommez ce fichier en .env si vous souhaitez surcharger les paramètres par défaut.
# Par défaut, si Ollama est démarré en local, les agents utilisent `qwen2.5:1.5b`.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:1.5b

# Optionnel : pour utiliser OpenAI à la place d'Ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=

# Ports MCP
MCP_PORT=24000
MCP_URL=http://localhost:24000/mcp
SAV_MCP_PORT=24001
SAV_MCP_URL=http://127.0.0.1:24001/mcp
